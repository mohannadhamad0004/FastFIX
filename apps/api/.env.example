# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Leave empty to use an in-memory database with the mock data (resets on restart).
# For a real PostgreSQL server: DATABASE_URL=postgres://postgres:password@localhost:5432/fastfix
DATABASE_URL=

# AI provider key - stays on the server only
ANTHROPIC_API_KEY=
